# The KB1 boot that CI runs (SDD 20, k): the supervisor first, then one process per
# test. Adding a server is adding a `process` line, its `handle` lines and its ELF.
moruna-manifest 1

channel pp
channel xfer
channel iso

process supervisor bin/supervisor
handle console console
handle root.process root.process
handle root.device root.device
handle root.interrupt root.interrupt
handle file:bin/child child-image

process fault bin/fault
handle console console

process ping bin/ping
handle console console
handle channel:pp.0 peer

process pong bin/pong
handle channel:pp.1 peer rights=read,write,wait

process xfer-a bin/xfer-a
handle console console
handle channel:xfer.0 peer

process xfer-b bin/xfer-b
handle console console
handle channel:xfer.1 peer

process iso-holder bin/iso-holder
handle console console
handle channel:iso.0 peer

process isolation bin/isolation
handle console console
handle channel:iso.1 peer

process deadline bin/deadline
handle console console
