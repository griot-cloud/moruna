# The cloud profile, step 1 (system design 1A): the one disk image for every cloud.
# Only the node supervisor starts in the initial manifest; it starts the services node.conf
# names: `devices`, the network server (`netstack`, configured by network.conf), `api` and
# `platform` (items 1.1, 1.3 and 1.4). package.py --profile cloud --assets kernel/node/cloud
# validates node.conf and network.conf with their actual parsers. Driver table data and driver
# images are emitted by moruna-image.
moruna-image 1
process node-supervisor
  handle console console
  handle root.process root.process
  handle root.device root.device
  handle root.ecam root.ecam
  handle root.msi root.msi
  handle root.dma root.dma
  # ABI 2.8 (item 5.0): the right to set the wall clock, which node.conf grants `platform`
  # alone (`grant platform clock root.clock`, with item 1.4's platform service).
  handle root.clock root.clock
  handle program:devices image.devices
  handle program:netstack image.netstack
  handle program:api image.api
  handle program:platform image.platform
  handle data:node.conf config
  handle data:network.conf network.config
  # Mozilla's roots as curl publishes them, for the network server's TLS (system design 3D):
  # kernel/node/tools/tls-roots.py converts it from curl's release, kept with its record in
  # kernel/node/tools/roots/.
  handle data:tls.roots tls.roots
  driver 1af4:1042 virtio-blk block
  driver 1af4:1041 virtio-net net
  driver 1b36:0010 nvme nvme
  driver 1ae0:0042 gve net
