# Stream B2-vm's measurement (vmcost/cost.sh; one boot, not a test): what a page costs the
# Linux personality. One process, no shell: b2vm-cost holds the process resource and its own
# image, and starts its child, b2vm-child, with a personality region.
moruna-image 1
process b2vm-cost
  handle console console
  handle root.process process
  handle program:b2vm-cost self-image
  expect B2VM cost: child: done
  expect B2VM cost: tester: done
  exits 0
