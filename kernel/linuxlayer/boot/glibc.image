# B2's booted test, mode glibc (kernel/linuxlayer/boot/boot.sh): the Linux personality
# launched by linuxlayer-boot with an initramfs holding a dynamic glibc program
# (linux/programs/dynamic.c, kernel/linux's LX-T12) at /kc1/bin/dynamic, its interpreter
# and its libraries, run first (rdinit=/kc1/bin/dynamic), with no shell.
moruna-image 1
process linuxlayer-boot
  handle console console
  handle root.process process
  handle data:linuxlayer/personality personality
  handle data:linuxlayer/initramfs.cpio initramfs
  handle data:linuxlayer/cmdline cmdline
  expect B2 boot: ok: launched the personality
  expect [kernel] initramfs is ready
  expect dynamic: readlink non-link, missing, real target and canonical path ok
  expect dynamic: readonly subrange alias, private copy and descriptor reuse ok
  expect dynamic glibc 2.
  expect kk: process linux exited with code 0 (
  expect B2 boot: ok: the personality's process ended
  exits 0
