                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rows_out": {
                "default": 0,
                "description": "Rows the last stage has produced so far.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "staging_bytes": {
                "default": 0,
                "description": "Bytes staged on disk.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "t_ms": {
