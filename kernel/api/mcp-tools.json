                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "t_ms",
              "rows_out",
              "bytes_out",
              "active_workers",
              "staging_bytes"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "The run's ID.",
            "type": "string"
          },
          "started": {
            "description": "When it began to run, in Unix seconds; absent until it has.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "description": "Where the job is in its life.",
            "oneOf": [
              {
                "const": "starting",
                "description": "The engine has taken the document and has not yet said how the run goes.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The engine runs it.",
                "type": "string"
              },
              {
                "const": "completed",
                "description": "It ended well: exit code 0.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "It ended with an error.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "It was cancelled: exit code 130.",
                "type": "string"
              }
            ]
          },
          "submitted": {
            "description": "When the node took the job, in Unix seconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "state",
          "submitted"
        ],
        "title": "JobStatus",
        "type": "object"
      }
    },
