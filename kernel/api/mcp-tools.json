{
  "tools": [
    {
      "description": "Whether the node is up. The only call that needs no token.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "moruna_health",
      "outputSchema": {
        "description": "The answer to `GET /v1/health`.",
        "properties": {
          "status": {
            "description": "Always `ok`: a node that answers is up.",
            "oneOf": [
              {
                "const": "ok",
                "description": "The node is up.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      }
    },
    {
      "description": "The node document: version, instance, cloud, cores, memory, executors, boot time, clock and health.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "moruna_node",
      "outputSchema": {
        "description": "The node document, the answer to `GET /v1/node`.",
        "properties": {
          "boot_ms": {
            "description": "Milliseconds from the core's first instruction to ready.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "cloud": {
            "description": "The cloud the node found at boot.",
            "oneOf": [
              {
                "const": "openstack",
                "description": "OpenStack, found by its instance data.",
                "type": "string"
              },
              {
                "const": "azure",
                "description": "Azure, found by its instance data.",
                "type": "string"
              },
              {
                "const": "none",
                "description": "No cloud: a development node, configured from a file in its image.",
                "type": "string"
              }
            ]
          },
          "cores": {
            "description": "The node's CPU cores.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "executors": {
            "description": "What the node can run work on.",
            "items": {
              "description": "One kind of executor and how many units of work it runs at once.",
              "properties": {
                "kind": {
                  "description": "The kind of executor.",
                  "oneOf": [
                    {
                      "const": "cpu",
                      "description": "The node's CPU cores.",
                      "type": "string"
                    }
                  ]
                },
                "slots": {
                  "description": "How many units of work it runs at once.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "slots"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "health": {
            "description": "Whether the node is healthy.",
            "oneOf": [
              {
                "const": "ok",
                "description": "Healthy.",
                "type": "string"
              },
              {
                "const": "degraded",
                "description": "Running, with a fault.",
                "type": "string"
              }
            ]
          },
          "instance": {
            "description": "The cloud's ID for this machine.",
            "type": "string"
          },
          "memory_bytes": {
            "description": "The node's memory, in bytes.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "time": {
            "description": "The node's wall clock, in Unix seconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "description": "The version of Moruna the node runs.",
            "type": "string"
          }
        },
        "required": [
          "version",
          "instance",
          "cloud",
          "cores",
          "memory_bytes",
          "executors",
          "boot_ms",
          "time",
          "health"
        ],
        "title": "Node",
        "type": "object"
      }
    },
    {
      "description": "The most recent calls to the node, newest first.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "moruna_node_audit",
      "outputSchema": {
        "description": "The answer to `GET /v1/node/audit`.",
        "properties": {
          "records": {
            "description": "The most recent calls, newest first.",
            "items": {
              "description": "The record one call leaves.",
              "properties": {
                "key": {
                  "description": "The first 16 hex characters of the SHA-256 of the token key's public bytes, or empty when\nthe call carried no valid token.",
                  "type": "string"
                },
                "operation": {
                  "description": "The operation called.",
                  "type": "string"
                },
                "scope": {
                  "description": "The token's scope.",
                  "items": {
                    "description": "What a token allows. `admin` covers `submit`, and `submit` covers `observe`.",
                    "oneOf": [
                      {
                        "const": "observe",
                        "description": "Read the node.",
                        "type": "string"
                      },
                      {
                        "const": "submit",
                        "description": "Submit work, and everything `observe` allows.",
                        "type": "string"
                      },
                      {
                        "const": "admin",
                        "description": "Administer the node, and everything `submit` allows.",
                        "type": "string"
                      }
                    ]
                  },
                  "type": "array"
                },
                "status": {
                  "description": "The HTTP status of the answer.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "time": {
                  "description": "When the call was made, in Unix seconds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "time",
                "key",
                "scope",
                "operation",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "records"
        ],
        "title": "Audit",
        "type": "object"
      }
    },
    {
      "description": "Whether the engine takes a job document, and its refusals when it does not. Nothing runs.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "A job as a client hands it to the node: the job document, as version 1 JSON (`v1`) or as\nversion 2's FlatBuffers in base64 (`v2`), exactly one of the two, and the secrets its\nobject-store settings refer to by name (`{\"secret\": \"<name>\"}`).",
        "properties": {
          "secrets": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The job's secrets (object-store credentials), by name: at most 32. They reach the engine\nbeside the document, never in it, and the node shows none of them in any answer, event,\nlog or report of this job.",
            "type": "object"
          },
          "v1": {
            "additionalProperties": true,
            "description": "The job document, version 1, as JSON.",
            "type": [
              "object",
              "null"
            ]
          },
          "v2": {
            "description": "The job document, version 2: its `MJB2` FlatBuffer in standard base64.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Job",
        "type": "object"
      },
      "name": "moruna_jobs_validate",
      "outputSchema": {
        "description": "The answer to `POST /v1/jobs/validate`: whether the engine takes the document.",
        "properties": {
          "ok": {
            "description": "Whether the document is sound.",
            "type": "boolean"
          },
          "refusals": {
            "description": "Why not, when it is not: `moruna-job`'s refusals.",
            "items": {
              "description": "One refusal of a job document, with the field it is about.",
              "properties": {
                "field": {
                  "description": "Where the problem is: `tasks[0].kind`, `budget.memory_bytes`, or `spec` for the document\nas a whole.",
                  "type": "string"
                },
                "message": {
                  "description": "One sentence that says what to change.",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Validation",
        "type": "object"
      }
    },
    {
      "description": "Run a job in a fresh engine and answer its run ID. Busy while a job runs; invalid with the engine's refusals.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "A job as a client hands it to the node: the job document, as version 1 JSON (`v1`) or as\nversion 2's FlatBuffers in base64 (`v2`), exactly one of the two, and the secrets its\nobject-store settings refer to by name (`{\"secret\": \"<name>\"}`).",
        "properties": {
          "secrets": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The job's secrets (object-store credentials), by name: at most 32. They reach the engine\nbeside the document, never in it, and the node shows none of them in any answer, event,\nlog or report of this job.",
            "type": "object"
          },
          "v1": {
            "additionalProperties": true,
            "description": "The job document, version 1, as JSON.",
            "type": [
              "object",
              "null"
            ]
          },
          "v2": {
            "description": "The job document, version 2: its `MJB2` FlatBuffer in standard base64.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Job",
        "type": "object"
      },
      "name": "moruna_jobs_submit",
      "outputSchema": {
        "description": "The answer to `POST /v1/jobs`: the job the node has taken.",
        "properties": {
          "id": {
            "description": "The run's ID.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "Submitted",
        "type": "object"
      }
    },
    {
      "description": "The last 100 jobs, newest first: each one's ID, state and times.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "moruna_jobs_list",
      "outputSchema": {
        "description": "The answer to `GET /v1/jobs`.",
        "properties": {
          "jobs": {
            "description": "The last 100 jobs, newest first.",
            "items": {
              "description": "One job in the list: its ID, its state and its times.",
              "properties": {
                "ended": {
                  "description": "When it ended, in Unix seconds; absent until it has.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "id": {
                  "description": "The run's ID.",
                  "type": "string"
                },
                "started": {
                  "description": "When it began to run, in Unix seconds; absent until it has.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "state": {
                  "description": "Where the job is in its life.",
                  "oneOf": [
                    {
                      "const": "starting",
                      "description": "The engine has taken the document and has not yet said how the run goes.",
                      "type": "string"
                    },
                    {
                      "const": "running",
                      "description": "The engine runs it.",
                      "type": "string"
                    },
                    {
                      "const": "completed",
                      "description": "It ended well: exit code 0.",
                      "type": "string"
                    },
                    {
                      "const": "failed",
                      "description": "It ended with an error.",
                      "type": "string"
                    },
                    {
                      "const": "cancelled",
                      "description": "It was cancelled: exit code 130.",
                      "type": "string"
                    }
                  ]
                },
                "submitted": {
                  "description": "When the node took the job, in Unix seconds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "state",
                "submitted"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "Jobs",
        "type": "object"
      }
    },
    {
