#!/usr/bin/env bash
# Moruna pre-commit hook. Installed by tools/hooks/install.sh, which points
# core.hooksPath at tools/hooks. It runs the fast half of the quality gate
# (tools/quality/check.sh --fast): formatting, clippy over every target, the lints
# and the documentation checks, in seconds on an incremental build. The tests, the
# coverage floor and the Python suite run in the GitHub Actions gate, and locally
# through tools/quality/check.sh. MORUNA_SKIP_QUALITY=1 skips the quality checks, for a human committing
# documentation on a machine without the Rust toolchain; CI re-runs the gate on the
# pull request regardless.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ "${MORUNA_SKIP_QUALITY:-0}" = "1" ]; then
  echo "pre-commit: quality checks skipped by MORUNA_SKIP_QUALITY=1 (CI still runs them)"
  exit 0
fi
exec tools/quality/check.sh --fast
