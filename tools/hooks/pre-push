#!/usr/bin/env bash
# Moruna pre-push hook. First refuses the push while GitHub Actions still has a run
# queued or running for the branch (tools/hooks/no-push-during-ci; MORUNA_SKIP_QUALITY
# does not skip this). Then runs the portable fast checks before publishing a branch.
# The required GitHub Actions check runs the full Linux quality gate, including
# per-crate coverage and a freshly installed Python wheel, before a release merge.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
tools/hooks/no-push-during-ci "$@"
if [ "${MORUNA_SKIP_QUALITY:-0}" = "1" ]; then
  echo "pre-push: quality gate skipped by MORUNA_SKIP_QUALITY=1 (CI still runs it)"
  exit 0
fi
exec tools/quality/check.sh --fast
