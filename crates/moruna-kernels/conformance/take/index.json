    },
    {
      "name": "not_nullable",
      "version": 1,
      "tests": [
        "params"
      ],
      "about": "When neither the values nor the index is nullable, the output is not nullable.",
      "arrays": {
        "values": {
          "file": "nn.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "nn.in.arrow"
        }
      ],
      "expected": "nn.expected.arrow"
    },
    {
      "name": "values_by_morsel",
      "version": 1,
      "tests": [
        "multi_batch",
        "nulls"
      ],
      "about": "With no values fixed, each index batch is taken from the values batch of its morsel.",
      "inputs": [
        {
          "file": "pair.index.arrow"
        },
        {
          "file": "pair.values.arrow"
        }
      ],
      "expected": "pair.expected.arrow"
    },
    {
      "name": "values_by_morsel_sliced",
      "version": 1,
      "tests": [
        "sliced"
      ],
      "about": "Both inputs sliced: each is numbered from its own first row.",
      "inputs": [
        {
          "file": "pair.index.arrow",
          "slice": [
            2,
            1
          ]
        },
        {
          "file": "pair.values.arrow",
          "slice": [
            1,
            2
          ]
        }
      ],
      "expected": "pair_sliced.expected.arrow"
    },
    {
      "name": "out_of_range",
      "version": 1,
      "tests": [
        "error"
      ],
      "about": "An index past the values refuses the batch.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "oob.in.arrow"
        }
      ],
      "error": {
        "at": "apply",
        "contains": "out of range"
      }
    },
    {
      "name": "negative_index",
      "version": 1,
      "tests": [
        "error"
      ],
      "about": "A negative index refuses the batch.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "neg.in.arrow"
        }
      ],
      "error": {
        "at": "apply",
        "contains": "out of range"
      }
    },
    {
      "name": "out_of_range_by_morsel",
      "version": 1,
      "tests": [
        "error"
      ],
      "about": "An index past its morsel's values refuses the batch.",
      "inputs": [
        {
          "file": "pair.index.arrow"
        },
        {
          "file": "pair.values.arrow",
          "slice": [
            0,
            2
          ]
        }
      ],
      "error": {
        "at": "apply",
        "contains": "out of range"
      }
    },
    {
      "name": "index_not_integer",
      "version": 1,
      "tests": [
