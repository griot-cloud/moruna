    {
      "name": "dictionary_values",
      "version": 1,
      "tests": [
        "dictionary",
        "nulls"
      ],
      "about": "Dictionary values give a dictionary column of the same type with the selected values.",
      "arrays": {
        "values": {
          "file": "dict.values.arrow"
