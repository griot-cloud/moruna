    {
      "name": "list_values",
      "version": 1,
      "tests": [
        "nested",
        "nulls"
      ],
      "about": "List values are gathered whole: empty lists, null lists and null items as given.",
      "arrays": {
        "values": {
          "file": "lists.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "lidx.in.arrow"
        }
      ],
      "expected": "lists.expected.arrow"
    },
    {
      "name": "list_values_sliced",
      "version": 1,
