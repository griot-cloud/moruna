{
  "format": "moruna-kernel-corpus/1",
  "kernel": "moruna.take",
  "cases": [
    {
      "name": "fixed_values",
      "version": 1,
      "tests": [
        "params",
        "ordering"
      ],
      "about": "With values fixed at configure, row i of the output is the value at index row i, an index may repeat, and the output is named and typed as the values.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "idx.in.arrow"
        }
      ],
      "expected": "idx.expected.arrow"
    },
    {
      "name": "nulls",
      "version": 1,
      "tests": [
        "nulls"
      ],
      "about": "A null index entry gives a null, and an entry that selects a null value gives a null.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "idx_nulls.in.arrow"
        }
      ],
      "expected": "idx_nulls.expected.arrow"
    },
    {
      "name": "sliced_index",
      "version": 1,
      "tests": [
        "sliced",
        "nulls"
      ],
      "about": "An index whose array starts at row 1 of its buffers is read from its own first row.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "idx_nulls.in.arrow",
          "slice": [
            1,
            3
          ]
        }
      ],
      "expected": "sliced_index.expected.arrow"
    },
    {
      "name": "sliced_values",
      "version": 1,
      "tests": [
        "sliced"
      ],
      "about": "Values whose array starts at row 3 of their buffers are numbered from their own first row.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow",
          "slice": [
            3,
            4
          ]
        }
      },
      "inputs": [
        {
          "file": "idx_small.in.arrow"
        }
      ],
      "expected": "sliced_values.expected.arrow"
    },
    {
      "name": "empty_index",
      "version": 1,
      "tests": [
        "empty"
      ],
      "about": "An index of zero rows gives zero rows.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "idx.in.arrow",
          "slice": [
            0,
            0
          ]
        }
      ],
      "expected": "empty.expected.arrow"
    },
    {
      "name": "no_batches",
      "version": 1,
      "tests": [
        "empty"
      ],
      "about": "No index batches give no output.",
      "arrays": {
        "values": {
          "file": "ints.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "none.in.arrow"
        }
      ],
      "expected": "none.expected.arrow"
    },
    {
      "name": "nulls_over_no_values",
      "version": 1,
      "tests": [
        "nulls",
        "empty"
      ],
      "about": "An index of nulls alone over no values gives nulls: a null entry is never out of range.",
      "arrays": {
        "values": {
          "file": "no_values.values.arrow"
        }
      },
      "inputs": [
        {
          "file": "all_null.in.arrow"
        }
      ],
      "expected": "all_null.expected.arrow"
    },
