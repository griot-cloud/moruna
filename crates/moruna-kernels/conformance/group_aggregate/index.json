{
  "format": "moruna-kernel-corpus/1",
  "kernel": "moruna.group_aggregate",
  "cases": [
    {
      "name": "every_aggregate",
      "version": 1,
      "tests": [
        "nulls",
        "multi_batch",
        "ordering",
        "params"
      ],
      "about": "count, sum, min, max and mean over two batches on the hash path: null keys are groups and sort last, null values are skipped, NaN is a float's min and max.",
      "params": {
        "keys": [
          "zone",
          "minute"
        ],
        "aggregates": [
          {
            "op": "count",
            "as": "rows"
          },
          {
            "op": "count",
            "column": "fare",
            "as": "fares"
          },
          {
            "op": "sum",
            "column": "n",
            "as": "n_sum"
          },
          {
            "op": "min",
            "column": "fare",
            "as": "fare_min"
          },
          {
            "op": "max",
            "column": "fare",
            "as": "fare_max"
          },
          {
            "op": "mean",
            "column": "n",
            "as": "n_mean"
          },
          {
            "op": "sum",
            "column": "fare",
            "as": "fare_sum"
          },
          {
            "op": "mean",
            "column": "fare",
            "as": "fare_mean"
          }
        ]
      },
      "inputs": [
        {
          "file": "trips.in.arrow"
        }
      ],
      "expected": "trips.expected.arrow"
    },
