{
  "format": "moruna-kernel-corpus/1",
  "kernel": "moruna.mlp_forward",
  "cases": [
    {
      "name": "score_float64",
      "version": 1,
      "tests": [
        "params",
        "rounding"
      ],
      "about": "Score's 23-128-128-1 network on January 2024's first 600 trips in float64, across the CPU reference's 256-row blocks.",
      "params": {
        "precision": "float64",
        "activations": [
          "relu",
          "relu",
          "identity"
        ],
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3",
          "x4",
          "x5",
          "x6",
          "x7",
          "x8",
          "x9",
          "x10",
          "x11",
          "x12",
          "x13",
          "x14",
          "x15",
          "x16",
          "x17",
          "x18",
          "x19",
          "x20",
          "x21",
          "x22"
        ],
        "output": "predicted_tip"
      },
      "arrays": {
        "layer_1": {
          "file": "score.layer_1.arrow"
        },
        "layer_2": {
          "file": "score.layer_2.arrow"
        },
        "layer_3": {
          "file": "score.layer_3.arrow"
        }
      },
      "inputs": [
        {
          "file": "score.in.arrow"
        }
      ],
      "expected": "score_float64.expected.arrow",
      "allowed": {
        "predicted_tip": {
          "file": "score_float64.allowed.arrow"
        }
      }
    },
