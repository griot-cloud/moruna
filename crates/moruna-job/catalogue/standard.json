  "kernels": [
    {
      "name": "package",
      "role": "kernel",
      "summary": "A function package, one .wasm or .pex file pinned by its sha256",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "The package's file, `.wasm` or `.pex`, on a disk the run attaches."
          },
          "fingerprint": {
            "type": "string",
            "description": "The file's `sha256`, as `moruna check` prints it (`sha256:<hex>`)."
          },
          "args": {
            "description": "The arguments of a kernel built by them (16 b)."
          },
          "assets": {
            "type": [
              "string",
              "null"
            ],
            "description": "A directory the kernel reads, read only (16 b)."
          },
          "ports": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/PortDoc"
            },
            "description": "For a `.wasm`: the ports its `call` may name, and where each goes (MH 4.10). A name not\nlisted here is refused when the stage calls it."
          }
        },
        "required": [
          "path",
          "fingerprint"
        ],
        "description": "A `package` entry's settings (16 d.4).",
        "title": "package",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "PortDoc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A port the host serves, by the name the host knows it by: the stage's calls go to the\nhost protocol's peer as `port_call` (MH 4.3)."
              },
              "guest": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A port answered inside the machine, by the handler the program running the document\nregistered under this name ([`super::Embedding::guest_port`])."
              },
              "deadline_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0,
                "description": "How long one call may wait for its answer; absent: half an hour\n(`moruna_kernel::ports::PORT_DEADLINE_MS`), at most a day."
              }
            },
            "description": "One port a stage may call (`ports.<name>`, MH 4.10): exactly one of `host` and `guest`."
          }
        },
        "examples": [
          {
            "path": "/disk/functions/shout.wasm",
            "fingerprint": "sha256:9f2c0d6a58e1b7c3f4a5e6d7c8b9a0f1e2d3c4b5a6978899aabbccddeeff0011"
          },
          {
            "path": "/disk/functions/classify.pex",
            "fingerprint": "sha256:0011ffeeddccbbaa99887766554433221100ffeeddccbbaa9988776655443322",
            "args": {
              "threshold": 0.5
            },
            "assets": "/disk/models/classifier"
          }
        ]
      },
      "inputs": "batches",
      "outputs": "batches",
      "needs": {
        "network": "no",
        "egress": [],
        "gpu": "no",
        "model_port": "by_settings",
        "contracts": "no"
      },
      "deterministic": "by_settings",
      "preserves_columns": "by_settings",
      "isolation": "confined"
    },
    {
      "name": "std",
      "role": "kernel",
      "summary": "A standard kernel of moruna-kernels, built by name and arguments",
      "settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The standard kernel's name.",
            "enum": [
              "cast",
              "rename",
              "select",
              "drop",
              "filter",
              "fill_null",
              "dedupe",
              "hash",
              "mask",
              "explode",
              "concat_str",
              "date_trunc",
              "union"
            ]
          },
          "args": {
            "description": "Its arguments, a JSON object whose keys the kernel's name decides (MH 4.9)."
          },
          "fingerprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "The fingerprint the kernel must have, hex, optionally prefixed `algo:`."
          }
        },
        "required": [
          "name"
        ],
        "description": "A `std` entry's settings.",
        "title": "std",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "examples": [
          {
            "name": "cast",
            "args": {
              "columns": {
                "a": "double"
              }
            }
          },
          {
            "name": "select",
            "args": {
              "columns": [
                "a",
                "b"
              ]
            }
          }
        ]
      },
      "inputs": "batches",
      "outputs": "batches",
      "needs": {
        "network": "no",
        "egress": [],
        "gpu": "no",
        "model_port": "no",
        "contracts": "no"
      },
      "deterministic": "yes",
      "preserves_columns": "by_settings",
      "isolation": "builtin"
    }
  ],
