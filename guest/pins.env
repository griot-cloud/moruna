# Every input of the Moruna guest image, pinned by version and digest. A change here is a
# new image; the release publishes it by digest. Fetched 2026-09-26.

# Linux, longterm 6.18 (kernel.org sha256sums.asc).
KERNEL_VERSION=6.18.54
KERNEL_SHA256=9df30b02dd8102bbd0be52556288ef6889ddbe7f1ddb96fbf847d0becf3eacac

# BusyBox, static, for the initramfs and poweroff (busybox.net .sha256).
BUSYBOX_VERSION=1.37.0
BUSYBOX_SHA256=3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4

# Free-threaded CPython 3.14 from python-build-standalone (release SHA256SUMS).
PYTHON_RELEASE=20260924
PYTHON_VERSION=3.14.7
PYTHON_SHA256_x86_64=30c0bc7fd98ef346baea2a77f76540d32fb6afd2eabc99ab0448efaa8c8ff004
PYTHON_SHA256_aarch64=1f6172db17b280a896aadaa531c58612940329c35383ce7c2c85b1e792b09215

# pyarrow for cp314t (PyPI digests).
PYARROW_VERSION=25.0.1
PYARROW_SHA256_x86_64=6a1fdfc6659b6b19022f2e50627fb5cf7156a66c46bf4299379955cbe742382a
PYARROW_SHA256_aarch64=f3831aaa25c67a99f99dc8b05873cb9d64560390372e2aa197ce9dd4a3f06a44

# The build container and the Debian archive the root filesystem is made from, frozen at a
# snapshot so a rebuild installs the same packages.
BUILD_IMAGE=debian@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
DEBIAN_SUITE=trixie
DEBIAN_SNAPSHOT=20260919T000000Z
