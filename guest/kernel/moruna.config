# The Moruna guest kernel: merged onto allnoconfig by build.sh. Exactly what one run needs:
# virtio-mmio block, vsock and memory devices, memory and CPU hot-plug, a serial console, and
# no network device driver of any kind (H10). Modules are off: the kernel is one file.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_LOCALVERSION="-moruna"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=n
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# Console.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_MAGIC_SYSRQ=n

# Boot: initramfs, then a read-only EROFS root with tmpfs where writes go.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EROFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BLOCK=y

# The devices: all virtio-mmio, no PCI.
CONFIG_PCI=n
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MEM=y

# vsock lives in the network core, so CONFIG_NET is on; nothing that could reach a wire is.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NETDEVICES=n
CONFIG_ETHERNET=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_VIRTIO_NET=n
CONFIG_TUN=n
CONFIG_BRIDGE=n
CONFIG_PACKET=n
CONFIG_NETFILTER=n

# Memory hot-plug through virtio-mem, onlined as movable by the kernel itself
# (memhp_default_state=online_movable on the command line).
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_MIGRATION=y
CONFIG_CONTIG_ALLOC=y

# CPU hot-plug; the udev rule in the root filesystem onlines what arrives.
CONFIG_HOTPLUG_CPU=y
