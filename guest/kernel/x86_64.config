# x86_64 additions: ACPI for the hot-plug controller, the GED and power-off; KVM paravirt.
CONFIG_X86_64=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_ACPI=y
CONFIG_ACPI_HOTPLUG_CPU=y
CONFIG_ACPI_PROCESSOR=y
# ACPICA installs a default handler for the PCI_Config address space before it loads any
# table, and that install fails with AE_BAD_PARAMETER without PCI support. No PCI bus is
# probed (pci=off on the command line) and no PCI driver is built.
CONFIG_PCI=y
CONFIG_INTEL_MEI=n
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_EXAR=n
CONFIG_SERIAL_8250_LPSS=n
CONFIG_SERIAL_8250_MID=n
CONFIG_SERIAL_8250_PERICOM=n
# The platform is hardware-reduced: no legacy PIC, so an interrupt line exists only once a
# DSDT _CRS names it. COM1 is a PNP0501 device there, bound by the 8250 PNP driver.
CONFIG_PNP=y
CONFIG_PNPACPI=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIO=n
# RETPOLINE became MITIGATION_RETPOLINE (6.9), under the CPU mitigations menu.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_RETPOLINE=y
