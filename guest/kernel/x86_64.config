# x86_64 additions: ACPI for the hot-plug controller, the GED and power-off; KVM paravirt.
CONFIG_X86_64=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_ACPI=y
CONFIG_ACPI_HOTPLUG_CPU=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_SERIAL_8250_PNP=n
CONFIG_SERIO=n
CONFIG_RETPOLINE=y
